# microservice specific routes

GET         /applications/:applicationId        uk.gov.hmrc.apiplatformadminapi.controllers.ApplicationsController.getApplication(applicationId: UUID)
GET         /applications                       uk.gov.hmrc.apiplatformadminapi.controllers.ApplicationsController.getApplicationsByQueryParam()

GET         /apis                               uk.gov.hmrc.apiplatformadminapi.controllers.ApiDefinitionController.fetch(serviceName: String, environment: Environment)

POST        /users/query                        uk.gov.hmrc.apiplatformadminapi.controllers.UsersController.userQuery()
